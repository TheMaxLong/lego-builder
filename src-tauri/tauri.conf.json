{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lego Builder",
  "version": "0.1.0",
  "identifier": "com.max.legobuilder",
  "build": { "frontendDist": "../app" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Lego Builder", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Library/Application Support/LegoBuilder/**", "$DOCUMENT/Lego Builder/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
